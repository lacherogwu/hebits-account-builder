<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.user.hebits-builder</string>
    <key>ProgramArguments</key><array>
        <string>__HOME__/Applications/node/bin/node</string>
        <string>__HOME__/Applications/hebits-account-builder/dist/server.mjs</string>
    </array>
    <key>WorkingDirectory</key><string>__HOME__/Applications/hebits-account-builder</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <!-- Must stay equal to config.json's `logFile` (default <config dir>/builder.log). The
         service logs with console.log, so every line lands here via launchd, and server.ts's
         rotateLog() truncates exactly this path once it passes 20 MB. Point these two
         somewhere else and the rotator faithfully rotates an empty file while the real log
         grows without limit. -->
    <key>StandardOutPath</key><string>__HOME__/.config/hebits-account-builder/builder.log</string>
    <key>StandardErrorPath</key><string>__HOME__/.config/hebits-account-builder/builder.log</string>
</dict>
</plist>
